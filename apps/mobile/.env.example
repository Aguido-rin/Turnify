# Supabase public configuration for the Turnify mobile app.
# Copy this file to `.env` and fill in the values. Never commit `.env`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ROUTING_PROVIDER=
EXPO_PUBLIC_OPENROUTESERVICE_KEY=

# Opcional: Para probar la interfaz en la computadora sin configurar Supabase (Modo Demo/Mock):
# EXPO_PUBLIC_SKIP_AUTH=1
